{{- /*
  MicroBin reads environment variables, so this file is a KEY=VALUE table.

  `env` is the part written out unchanged: one baseline table, the instance
  merging over it key by key, and the template recognising none of the keys —
  adding a MicroBin variable changes YAML only.

  The rest is derived: the port and the address come from the instance, the
  public name from the port's `published`, the passwords from secrets.

  Basic auth and the administrative interface are two different things, so
  they are two switches: `auth_enabled` guards reading the site at all, and
  `admin_enabled` opens the administrative interface. A machine may want the
  second without the first.
*/ -}}
{{- $env := (defaults).env -}}
{{- with (instance).values.env }}{{ $env = merge . (defaults).env }}{{ end -}}
MICROBIN_BIND={{ (instance).bind }}
MICROBIN_PORT={{ index (instance).ports "web" }}
MICROBIN_PUBLIC_PATH=https://{{ published "web" }}/
{{ range $name, $value := $env }}{{ $name }}={{ $value }}
{{ end }}
{{- if (instance).values.auth_enabled }}
MICROBIN_BASIC_AUTH_USERNAME={{ (defaults).basic_auth_username }}
MICROBIN_BASIC_AUTH_PASSWORD={{ secret "auth_password" }}
{{ end -}}
{{- if (instance).values.admin_enabled }}
MICROBIN_ADMIN_USERNAME={{ (defaults).admin_username }}
MICROBIN_ADMIN_PASSWORD={{ secret "admin_password" }}
{{ end -}}
{{- if (instance).values.upload_enabled }}
MICROBIN_UPLOADER_PASSWORD={{ secret "upload_password" }}
{{ end -}}
